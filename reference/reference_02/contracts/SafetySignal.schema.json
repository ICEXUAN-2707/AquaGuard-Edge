{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "signal_id": {
      "type": "string"
    },
    "device_id": {
      "type": "string"
    },
    "signal_type": {
      "type": "string"
    },
    "observed_at": {
      "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "value": {
      "type": "boolean"
    },
    "quality": {
      "enum": ["VALID", "INVALID", "UNKNOWN", "STALE"]
    },
    "observation_refs": {
      "type": "array",
      "items": {
        "type": "string", "minLength": 1
      }, "minItems": 1, "uniqueItems": true
    },
    "origin": {"enum": ["hardware", "simulation", "mixed", "unknown"]}
  },
  "required": [
    "schema_version",
    "signal_id",
    "device_id",
    "signal_type",
    "observed_at",
    "value",
    "quality",
    "observation_refs",
    "origin"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SafetySignal"
}
