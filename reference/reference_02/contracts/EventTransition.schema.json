{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "transition_id": {
      "type": "string"
    },
    "event_id": {
      "type": "string"
    },
    "event_version": {
      "type": "integer", "minimum": 1
    },
    "transition_type": {
      "type": "string"
    },
    "occurred_at": {
      "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "actor": {
      "type": "string"
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "origin": {"enum": ["hardware", "simulation", "mixed", "unknown"]}
  },
  "required": [
    "schema_version",
    "transition_id",
    "event_id",
    "event_version",
    "transition_type",
    "occurred_at",
    "actor",
    "reason_codes",
    "evidence_refs",
    "origin"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EventTransition"
}
