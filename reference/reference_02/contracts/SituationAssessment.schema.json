{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "assessment_id": {
      "type": "string"
    },
    "window_id": {
      "type": "string"
    },
    "device_id": {
      "type": "string"
    },
    "situation": {
      "enum": ["IDLE", "ATTENDED_FLOW", "POSSIBLE_UNATTENDED_FLOW", "UNKNOWN"]
    },
    "inference_mode": {
      "enum": ["rules", "ml", "fallback"]
    },
    "model_version": {
      "type": "string"
    },
    "model_score": {
      "type": ["number", "null"]
    },
    "data_quality": {
      "enum": ["VALID", "DEGRADED", "UNAVAILABLE"]
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "origin": {"enum": ["hardware", "simulation", "mixed", "unknown"]}
  },
  "required": [
    "schema_version",
    "assessment_id",
    "window_id",
    "device_id",
    "situation",
    "inference_mode",
    "model_version",
    "model_score",
    "data_quality",
    "reason_codes",
    "origin"
  ],
  "additionalProperties": false,
  "allOf": [
    {"if": {"properties": {"inference_mode": {"const": "rules"}}}, "then": {"properties": {"model_score": {"type": "null"}}}}
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SituationAssessment"
}
