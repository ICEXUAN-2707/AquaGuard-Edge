{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "event_id": {
      "type": "string"
    },
    "device_id": {
      "type": "string"
    },
    "event_type": {
      "type": "string"
    },
    "lifecycle": {
      "enum": ["OPEN", "RESOLVED", "CLOSED"]
    },
    "ack_status": {
      "enum": ["UNACKNOWLEDGED", "ACKNOWLEDGED"]
    },
    "physical_status": {
      "enum": ["ACTIVE", "CLEARED", "UNKNOWN"]
    },
    "escalation_level": {
      "enum": ["L0", "L1", "L2", "L3"]
    },
    "version": {
      "type": "integer", "minimum": 1
    },
    "created_at": {
      "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "origin": {"enum": ["hardware", "simulation", "mixed", "unknown"]}
  },
  "required": [
    "schema_version",
    "event_id",
    "device_id",
    "event_type",
    "lifecycle",
    "ack_status",
    "physical_status",
    "escalation_level",
    "version",
    "created_at",
    "origin"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SafetyEvent"
}
