{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "observation_id": {
      "type": "string"
    },
    "device_id": {
      "type": "string"
    },
    "sensor_type": {
      "enum": ["flow", "water", "presence"]
    },
    "boot_id": {
      "type": "string"
    },
    "seq": {
      "type": "integer", "minimum": 0
    },
    "uptime_ms": {
      "type": "integer", "minimum": 0
    },
    "event_time": {
      "anyOf": [{"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"}, {"type": "null"}]
    },
    "received_at": {
      "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "time_basis": {
      "enum": ["DEVICE_SYNCED", "EDGE_MAPPED", "RECEIVED_FALLBACK"]
    },
    "value": {
      "type": "object"
    },
    "quality": {
      "enum": ["valid", "invalid", "unknown", "stale", "duplicate", "late"]
    },
    "source": {
      "enum": ["hardware", "simulation"]
    }
  },
  "required": [
    "schema_version",
    "observation_id",
    "device_id",
    "sensor_type",
    "boot_id",
    "seq",
    "uptime_ms",
    "event_time",
    "received_at",
    "time_basis",
    "value",
    "quality",
    "source"
  ],
  "additionalProperties": false,
  "allOf": [
    {"if": {"properties": {"sensor_type": {"const": "flow"}}}, "then": {"properties": {"value": {"$ref": "#/$defs/flowValue"}}}},
    {"if": {"properties": {"sensor_type": {"const": "water"}}}, "then": {"properties": {"value": {"$ref": "#/$defs/waterValue"}}}},
    {"if": {"properties": {"sensor_type": {"const": "presence"}}}, "then": {"properties": {"value": {"$ref": "#/$defs/presenceValue"}}}}
  ],
  "$defs": {
    "flowValue": {
      "type": "object",
      "properties": {
        "pulse_count": {"type": "integer", "minimum": 0},
        "interval_ms": {"type": "integer", "exclusiveMinimum": 0},
        "estimated_lpm": {"type": "number", "minimum": 0},
        "calibration_id": {"type": "string", "minLength": 1}
      },
      "required": ["pulse_count", "interval_ms", "estimated_lpm", "calibration_id"],
      "additionalProperties": false
    },
    "waterValue": {
      "type": "object", "properties": {"wet": {"type": ["boolean", "null"]}},
      "required": ["wet"], "additionalProperties": false
    },
    "presenceValue": {
      "type": "object",
      "properties": {
        "present": {"type": ["boolean", "null"]},
        "moving": {"type": ["boolean", "null"]},
        "still": {"type": ["boolean", "null"]}
      },
      "required": ["present", "moving", "still"],
      "additionalProperties": false
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SensorObservation"
}
