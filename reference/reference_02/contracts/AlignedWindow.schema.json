{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "window_id": {
      "type": "string"
    },
    "device_id": {
      "type": "string"
    },
    "window_start": {
      "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "window_end": {
      "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "published_at": {
      "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "alignment_config_version": {
      "type": "string"
    },
    "sensor_summary": {
      "type": "object",
      "properties": {
        "flow": {"$ref": "#/$defs/flowSummary"},
        "water": {"$ref": "#/$defs/waterSummary"},
        "presence": {"$ref": "#/$defs/presenceSummary"}
      },
      "required": ["flow", "water", "presence"],
      "additionalProperties": false
    },
    "origin": {"enum": ["hardware", "simulation", "mixed", "unknown"]},
    "quality_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_observation_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "window_id",
    "device_id",
    "window_start",
    "window_end",
    "published_at",
    "alignment_config_version",
    "sensor_summary",
    "origin",
    "quality_flags",
    "source_observation_ids"
  ],
  "additionalProperties": false,
  "$defs": {
    "flowSummary": {
      "type": "object",
      "properties": {"state": {"enum": ["active", "inactive", "unknown"]}, "age_sec": {"type": ["number", "null"], "minimum": 0}, "coverage_ratio": {"type": "number", "minimum": 0, "maximum": 1}},
      "required": ["state", "age_sec", "coverage_ratio"], "additionalProperties": false
    },
    "waterSummary": {
      "type": "object",
      "properties": {"state": {"enum": ["wet", "dry", "unknown"]}, "age_sec": {"type": ["number", "null"], "minimum": 0}, "coverage_ratio": {"type": "number", "minimum": 0, "maximum": 1}},
      "required": ["state", "age_sec", "coverage_ratio"], "additionalProperties": false
    },
    "presenceSummary": {
      "type": "object",
      "properties": {"state": {"enum": ["present", "absent", "unknown"]}, "age_sec": {"type": ["number", "null"], "minimum": 0}, "coverage_ratio": {"type": "number", "minimum": 0, "maximum": 1}},
      "required": ["state", "age_sec", "coverage_ratio"], "additionalProperties": false
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AlignedWindow"
}
