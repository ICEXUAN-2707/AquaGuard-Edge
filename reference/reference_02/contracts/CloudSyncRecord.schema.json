{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "message_id": {
      "type": "string"
    },
    "transition_id": {
      "type": "string"
    },
    "destination": {
      "const": "huawei_iotda"
    },
    "sync_status": {
      "enum": ["PENDING", "SENDING", "RETRY_WAIT", "ACCEPTED", "FAILED"]
    },
    "attempts": {
      "type": "integer", "minimum": 0
    },
    "next_retry_at": {
      "anyOf": [{"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"}, {"type": "null"}]
    },
    "last_error": {
      "type": ["string", "null"]
    },
    "transport_receipt": {
      "type": ["object", "null"],
      "properties": {"provider": {"type": "string", "minLength": 1}, "receipt_id": {"type": "string", "minLength": 1}, "received_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"}},
      "required": ["provider", "receipt_id", "received_at"], "additionalProperties": false
    },
    "business_receipt": {
      "type": ["object", "null"],
      "properties": {"provider": {"type": "string", "minLength": 1}, "receipt_id": {"type": "string", "minLength": 1}, "received_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"}},
      "required": ["provider", "receipt_id", "received_at"], "additionalProperties": false
    },
    "origin": {"enum": ["hardware", "simulation", "mixed", "unknown"]}
  },
  "required": [
    "schema_version",
    "message_id",
    "transition_id",
    "destination",
    "sync_status",
    "attempts",
    "next_retry_at",
    "last_error",
    "transport_receipt",
    "business_receipt",
    "origin"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CloudSyncRecord"
}
